# Окружение приложения
APP_ENV=dev
LOG_LEVEL=INFO

# Параметры FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Оркестратор
MAX_ITERATIONS=5

# Поставщик LLM: stub | openai | yandexgpt
# На Этапе 1 используются заглушки, реальные ключи не нужны.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# PostgreSQL для локальной разработки.
# Порт 5433 на хосте — у разработчика 5432 может быть занят другим Postgres.
# В проде значения переопределяются через переменные окружения контейнера.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=greendata_sql
POSTGRES_USER=greendata
POSTGRES_PASSWORD=greendata
