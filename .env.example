# Окружение приложения
APP_ENV=dev
LOG_LEVEL=INFO

# Параметры FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Оркестратор
MAX_ITERATIONS=5

# === LLM ===
# Поставщик: stub | openrouter | ollama | openai | yandexgpt
# stub -- заглушки, реальные ключи не нужны (для разработки API без LLM).
LLM_PROVIDER=stub

# Ключ API провайдера. Для openrouter: https://openrouter.ai/keys
# Для ollama не обязателен (можно оставить пустым).
LLM_API_KEY=

# Базовый URL. Если пусто -- берётся по имени провайдера:
#   openrouter -> https://openrouter.ai/api/v1
#   ollama     -> http://localhost:11434/v1
#   openai     -> https://api.openai.com/v1
LLM_BASE_URL=

# Общая модель по умолчанию (используется, если не заданы модели ниже).
# Примеры: deepseek/deepseek-chat | qwen/qwen3-coder:free | openai/gpt-oss-20b:free
LLM_MODEL=

# Раздельные модели для генератора / репаратора / аудитора.
# Если не заданы -- используется LLM_MODEL.
GENERATOR_MODEL=
REPAIR_MODEL=
JUDGE_MODEL=

# Параметры генерации
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=4

# Путь к DDL-схеме БД (парсится в кеш при старте приложения)
DB_SCHEMA_PATH=data_model.sql

# Сколько релевантных таблиц подавать в контекст промпта
SCHEMA_TOP_K_TABLES=5

# PostgreSQL для локальной разработки.
# Порт 5433 на хосте — у разработчика 5432 может быть занят другим Postgres.
# В проде значения переопределяются через переменные окружения контейнера.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=greendata_sql
POSTGRES_USER=greendata
POSTGRES_PASSWORD=greendata
